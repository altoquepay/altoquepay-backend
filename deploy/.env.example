# Copy to .env next to compose.yml and fill it in. Never commit .env.

# Public name of the server, such as altoquepay.duckdns.org, or localhost for a local test.
DOMAIN=

# Generate each one with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# System administrator created on the first start, who must change the password on first sign-in.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# CORS_ORIGINS and FRONTEND_URL are set in compose.yml, which overrides this file.

# Without SMTP_HOST, the password reset links are written to the API logs instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
